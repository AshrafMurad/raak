// Raak — Sprint 1 identity/control plane, Sprint 2 catalog/guest intake,
// Sprint 3 commercial quotes, Sprint 4 people/access/private files and
// Sprint 5 care plans/visits/scheduling.

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// docs 06 — tenants. One row per agency workspace (multi-tenant root).
model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  legalName       String       @map("legal_name")
  displayName     String       @map("display_name")
  status          TenantStatus @default(PENDING_APPROVAL)
  timezone        String
  currency        String       @db.Char(3)
  travelBufferMin Int          @default(30) @map("travel_buffer_min")
  /// docs 04 BR-CHG — customer change-request cutoffs (hours before the
  /// scheduled start) and the late-review policy flag.
  changeCancelCutoffHours      Int     @default(24) @map("change_cancel_cutoff_hours")
  changeRescheduleCutoffHours  Int     @default(24) @map("change_reschedule_cutoff_hours")
  allowLateReview              Boolean @default(true) @map("allow_late_review")
  /// Optimistic concurrency for scheduling-policy settings edits.
  settingsVersion              Int     @default(0) @map("settings_version")
  notificationSettingsVersion Int     @default(0) @map("notification_settings_version")
  supportEmail    String       @map("support_email")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  brandJson       Json?        @map("brand_json")
  brandVersion    Int          @default(0) @map("brand_version")

  staffAccounts    StaffAccount[]
  customerAccounts CustomerAccount[]
  staffInvitations StaffInvitation[]
  caregivers       Caregiver[]
  agencyServices   AgencyService[]
  patients         Patient[]
  documents        Document[]
  carePlans        CarePlan[]
  visits           Visit[]
  visitNotes       VisitNote[]
  visitChanges     VisitChangeRequest[]
  notificationPolicies NotificationPolicy[]
  notificationPreferences NotificationPreference[]

  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

/// docs 05 — principal audiences.
enum PrincipalType {
  PLATFORM_OPERATOR
  AGENCY_STAFF
  AGENCY_CUSTOMER

  @@map("principal_type")
}

/// docs 05 — staff roles (AGENCY_OWNER exists only via agency registration;
/// invitations may only carry the other three).
enum StaffRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  CARE_COORDINATOR
  CAREGIVER

  @@map("staff_role")
}

/// Shared account lifecycle for platform operators, staff and customers.
/// Platform operators and invitation-accepted staff start ACTIVE;
/// self-registered owners/customers start PENDING_VERIFICATION.
enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

/// One-time capability emails (owner verification, password reset).
enum EmailTokenPurpose {
  OWNER_VERIFICATION
  PASSWORD_RESET

  @@map("email_token_purpose")
}

/// docs 06 — platform_operators. Separate identity realm; no tenant credentials.
model PlatformOperator {
  id              String        @id @default(uuid()) @db.Uuid
  emailNormalized String        @unique @map("email_normalized")
  passwordHash    String        @map("password_hash")
  status          AccountStatus @default(ACTIVE)
  sessionVersion  Int           @default(0) @map("session_version")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("platform_operators")
}

/// docs 06 — staff_accounts. Invitation-based; unique per tenant.
model StaffAccount {
  notificationLocale String @default("ar") @map("notification_locale")
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  emailNormalized String        @map("email_normalized")
  passwordHash    String        @map("password_hash")
  role            StaffRole
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  sessionVersion  Int           @default(0) @map("session_version")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  invitationsCreated    StaffInvitation[]        @relation("InvitationCreator")
  caregiver             Caregiver?
  requestNotifications  RequestNotification[]
  patientGrantsReviewed PatientAccess[]
  duplicateReviews      PatientDuplicateReview[]
  approvedPlanVersions  CarePlanVersion[]        @relation("PlanClinicalApprover")
  visitNotes            VisitNote[]
  visitChangeDecisions  VisitChangeRequest[]
  visitReviews          VisitReview[]
  notificationPoliciesUpdated NotificationPolicy[]

  @@unique([tenantId, emailNormalized])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("staff_accounts")
}

/// docs 06 — customer_accounts. Same-email accounts in different tenants are
/// independent; tenant is resolved (host) before authentication.
model CustomerAccount {
  notificationLocale String @default("ar") @map("notification_locale")
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  emailNormalized String               @map("email_normalized")
  passwordHash    String               @map("password_hash")
  status          AccountStatus        @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?            @map("email_verified_at")
  sessionVersion  Int                  @default(0) @map("session_version")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  capabilities    CustomerCapability[]
  grants          PatientAccess[]
  ownedRequests   ServiceRequest[]
  visitChangeRequests VisitChangeRequest[]

  @@unique([tenantId, emailNormalized])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("customer_accounts")
}

/// docs 06 — staff_invitations. Hashed opaque token, single-use, 48h expiry.
model StaffInvitation {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  emailNormalized      String       @map("email_normalized")
  role                 StaffRole
  caregiverProfileJson Json?        @map("caregiver_profile_json")
  tokenHash            String       @unique @map("token_hash")
  expiresAt            DateTime     @map("expires_at")
  consumedAt           DateTime?    @map("consumed_at")
  createdByStaffId     String       @map("created_by_staff_id") @db.Uuid
  createdBy            StaffAccount @relation("InvitationCreator", fields: [createdByStaffId], references: [id])
  createdAt            DateTime     @default(now()) @map("created_at")

  @@index([tenantId, emailNormalized])
  @@map("staff_invitations")
}

/// docs 06 — auth_sessions. No raw token at rest; only sha-256 hashes.
/// principalId/tenantId are polymorphic scalars (no FK) by design.
model AuthSession {
  id             String        @id @default(uuid()) @db.Uuid
  principalType  PrincipalType @map("principal_type")
  principalId    String        @map("principal_id") @db.Uuid
  tenantId       String?       @map("tenant_id") @db.Uuid
  secretHash     String        @unique @map("secret_hash")
  csrfTokenHash  String        @map("csrf_token_hash")
  sessionVersion Int           @map("session_version")
  expiresAt      DateTime      @map("expires_at")
  revokedAt      DateTime?     @map("revoked_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([principalId])
  @@index([tenantId])
  @@map("auth_sessions")
}

/// One-time email capability tokens, stored hashed only (docs 05).
model EmailToken {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String?           @map("tenant_id") @db.Uuid
  purpose       EmailTokenPurpose
  principalType PrincipalType     @map("principal_type")
  principalId   String            @map("principal_id") @db.Uuid
  tokenHash     String            @unique @map("token_hash")
  expiresAt     DateTime          @map("expires_at")
  consumedAt    DateTime?         @map("consumed_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([principalId, purpose])
  @@map("email_tokens")
}

/// Append-only audit trail for tenant status changes, operator actions and
/// auth events (docs 06 AUDIT_EVENT + docs 07 /platform/audit).
/// tenantId nullable for platform-scope rows; never hard-deleted.
model AuditEvent {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  actorType    PrincipalType? @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String
  subjectType  String         @map("subject_type")
  subjectId    String?        @map("subject_id") @db.Uuid
  reason       String?
  metadataJson Json           @map("metadata_json")
  at           DateTime       @default(now())

  @@index([tenantId, at])
  @@index([action, at])
  @@map("audit_events")
}

/// docs 06 — caregivers (minimal Sprint 1 columns; qualification workflow and
/// availability arrive in Sprint 4-5). operationalStatus INACTIVE until then.
model Caregiver {
  id                              String                          @id @default(uuid()) @db.Uuid
  tenantId                        String                          @map("tenant_id") @db.Uuid
  tenant                          Tenant                          @relation(fields: [tenantId], references: [id])
  staffAccountId                  String?                         @unique @map("staff_account_id") @db.Uuid
  staffAccount                    StaffAccount?                   @relation(fields: [staffAccountId], references: [id])
  name                            String
  professionalCategory            String                          @map("professional_category")
  operationalStatus               String                          @default("INACTIVE") @map("operational_status")
  serviceAreasJson                Json                            @default("[]") @map("service_areas_json")
  qualificationVerificationStatus String                          @default("UNVERIFIED") @map("qualification_verification_status")
  createdAt                       DateTime                        @default(now()) @map("created_at")
  updatedAt                       DateTime                        @updatedAt @map("updated_at")
  version                         Int                             @default(1)
  availabilityRevision            Int                             @default(1) @map("availability_revision")
  qualifications                  CaregiverQualification[]
  serviceAuthorizations           CaregiverServiceAuthorization[]
  availabilitySlots               AvailabilitySlot[]
  exceptions                      AvailabilityException[]
  primaryCarePlans                CarePlan[]                      @relation("PlanPrimaryCaregiver")
  assignedVisits                  Visit[]                         @relation("VisitAssignment")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("caregivers")
}

model CaregiverQualification {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  caregiverId             String    @map("caregiver_id") @db.Uuid
  caregiver               Caregiver @relation(fields: [tenantId, caregiverId], references: [tenantId, id])
  code                    String
  licenseIssuer           String    @map("license_issuer")
  licenseNumberRestricted String    @map("license_number_restricted")
  validThrough            String?   @map("valid_through") @db.VarChar(10)
  documentId              String?   @map("document_id") @db.Uuid
  document                Document? @relation(fields: [tenantId, documentId], references: [tenantId, id])
  status                  String    @default("PENDING")
  verifiedBy              String?   @map("verified_by") @db.Uuid
  verifiedAt              DateTime? @map("verified_at")
  version                 Int       @default(1)

  @@index([tenantId, caregiverId])
  @@map("caregiver_qualifications")
}

model CaregiverServiceAuthorization {
  tenantId        String        @map("tenant_id") @db.Uuid
  caregiverId     String        @map("caregiver_id") @db.Uuid
  caregiver       Caregiver     @relation(fields: [tenantId, caregiverId], references: [tenantId, id])
  agencyServiceId String        @map("agency_service_id") @db.Uuid
  service         AgencyService @relation(fields: [tenantId, agencyServiceId], references: [tenantId, id])
  authorizedBy    String        @map("authorized_by") @db.Uuid
  authorizedAt    DateTime      @map("authorized_at")

  @@id([tenantId, caregiverId, agencyServiceId])
  @@map("caregiver_service_authorizations")
}

model AvailabilitySlot {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  caregiverId    String    @map("caregiver_id") @db.Uuid
  caregiver      Caregiver @relation(fields: [tenantId, caregiverId], references: [tenantId, id])
  weekday        Int
  localStartTime String    @map("local_start_time") @db.VarChar(5)
  localEndTime   String    @map("local_end_time") @db.VarChar(5)
  effectiveFrom  String?   @map("effective_from") @db.VarChar(10)
  effectiveTo    String?   @map("effective_to") @db.VarChar(10)

  @@index([tenantId, caregiverId, weekday])
  @@map("availability_slots")
}

model AvailabilityException {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  caregiverId String    @map("caregiver_id") @db.Uuid
  caregiver   Caregiver @relation(fields: [tenantId, caregiverId], references: [tenantId, id])
  localDate   String    @map("local_date") @db.VarChar(10)
  startLocal  String?   @map("start_local") @db.VarChar(5)
  endLocal    String?   @map("end_local") @db.VarChar(5)
  type        String
  reason      String
  approvedBy  String    @map("approved_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, caregiverId, localDate])
  @@map("availability_exceptions")
}

model Document {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @map("tenant_id") @db.Uuid
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  parentType             String                   @map("parent_type")
  parentId               String                   @map("parent_id") @db.Uuid
  classification         String
  storageKey             String                   @unique @map("storage_key")
  originalNameRestricted String                   @map("original_name_restricted")
  mime                   String
  sizeBytes              Int                      @map("size_bytes")
  checksum               String?
  scanStatus             String                   @default("PENDING") @map("scan_status")
  scanStartedAt          DateTime?                @map("scan_started_at")
  createdBy              String                   @map("created_by") @db.Uuid
  createdAt              DateTime                 @default(now()) @map("created_at")
  uploadExpiresAt        DateTime                 @map("upload_expires_at")
  archivedAt             DateTime?                @map("archived_at")
  tickets                DocumentTicket[]
  evidenceGrants         PatientAccess[]
  qualifications         CaregiverQualification[]

  @@unique([tenantId, id])
  @@index([tenantId, parentType, parentId])
  @@map("documents")
}

model DocumentTicket {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [tenantId, documentId], references: [tenantId, id])
  sessionId  String   @map("session_id") @db.Uuid
  secretHash String   @unique @map("secret_hash")
  expiresAt  DateTime @map("expires_at")

  @@map("document_tickets")
}

/// docs 08 — outbox stub: state changes and their events commit in one DB
/// transaction; a later sprint's worker dispatches due events to BullMQ.
model OutboxEvent {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String?         @map("tenant_id") @db.Uuid
  eventType      String          @map("event_type")
  aggregateId    String          @map("aggregate_id") @db.Uuid
  payloadMinimal Json            @map("payload_minimal")
  createdAt      DateTime        @default(now()) @map("created_at")
  processedAt    DateTime?       @map("processed_at")
  deliveries     EmailDelivery[]
  notifications Notification[]
  notificationDeliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

model PlatformService {
  id       String          @id @default(uuid()) @db.Uuid
  code     String          @unique
  config   Json
  active   Boolean         @default(true)
  services AgencyService[]

  @@map("platform_services")
}

model AgencyService {
  id                      String                          @id @default(uuid()) @db.Uuid
  tenantId                String                          @map("tenant_id") @db.Uuid
  tenant                  Tenant                          @relation(fields: [tenantId], references: [id])
  templateId              String?                         @map("template_id") @db.Uuid
  template                PlatformService?                @relation(fields: [templateId], references: [id])
  slug                    String
  config                  Json
  isEnabled               Boolean                         @default(true) @map("is_enabled")
  isPublished             Boolean                         @default(false) @map("is_published")
  version                 Int                             @default(1)
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  requests                ServiceRequest[]
  caregiverAuthorizations CaregiverServiceAuthorization[]
  carePlans               CarePlan[]
  visits                  Visit[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
  @@map("agency_services")
}

model ServiceRequest {
  id                       String                 @id @default(uuid()) @db.Uuid
  tenantId                 String                 @map("tenant_id") @db.Uuid
  agencyServiceId          String                 @map("agency_service_id") @db.Uuid
  service                  AgencyService          @relation(fields: [tenantId, agencyServiceId], references: [tenantId, id])
  customerAccountId        String?                @map("customer_account_id") @db.Uuid
  customer                 CustomerAccount?       @relation(fields: [tenantId, customerAccountId], references: [tenantId, id])
  patientId                String?                @map("patient_id") @db.Uuid
  patient                  Patient?               @relation(fields: [tenantId, patientId], references: [tenantId, id])
  reference                String
  idempotencyKey           String                 @map("idempotency_key")
  payloadHash              String                 @map("payload_hash")
  requesterName            String                 @map("requester_name")
  requesterEmailNormalized String                 @map("requester_email_normalized")
  requesterPhone           String                 @map("requester_phone")
  beneficiaryName          String                 @map("beneficiary_name")
  relationship             String
  areaId                   String                 @map("area_id")
  preferredWindowJson      Json                   @map("preferred_window_json")
  notesRestricted          String                 @map("notes_restricted")
  locale                   String
  privacyVersion           String                 @map("privacy_version")
  serviceSnapshot          Json                   @map("service_snapshot")
  priceAcknowledged        Boolean                @map("price_acknowledged")
  status                   String                 @default("SUBMITTED")
  version                  Int                    @default(1)
  decisionAt               DateTime?              @map("decision_at")
  decisionStaffId          String?                @map("decision_staff_id") @db.Uuid
  decisionReason           String?                @map("decision_reason")
  submittedAt              DateTime               @default(now()) @map("submitted_at")
  tokens                   GuestActionToken[]
  sessions                 GuestSession[]
  history                  RequestStatusHistory[]
  notifications            RequestNotification[]
  quotes                   Quote[]
  claimCapabilities        CustomerCapability[]
  carePlans                CarePlan[]

  @@unique([tenantId, id])
  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, submittedAt])
  @@map("service_requests")
}

model CustomerCapability {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  customer        CustomerAccount @relation(fields: [tenantId, customerId], references: [tenantId, id])
  requestId       String?         @map("request_id") @db.Uuid
  request         ServiceRequest? @relation(fields: [tenantId, requestId], references: [tenantId, id])
  purpose         String
  tokenHash       String          @unique @map("token_hash")
  encryptedSecret String?         @map("encrypted_secret")
  emailHash       String          @map("email_hash")
  locale          String
  expiresAt       DateTime        @map("expires_at")
  consumedAt      DateTime?       @map("consumed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([tenantId, customerId, createdAt])
  @@map("customer_capabilities")
}

model Patient {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  displayName       String                   @map("display_name")
  normalizedName    String                   @map("normalized_name")
  dateOfBirth       String?                  @map("date_of_birth") @db.VarChar(10)
  contact           String                   @default("")
  areaId            String                   @map("area_id")
  addressRestricted String                   @default("") @map("address_restricted")
  notesRestricted   String                   @default("") @map("notes_restricted")
  status            String                   @default("ACTIVE")
  version           Int                      @default(1)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  requests          ServiceRequest[]
  grants            PatientAccess[]
  reviews           PatientDuplicateReview[]
  carePlans         CarePlan[]
  visits            Visit[]

  @@unique([tenantId, id])
  @@index([tenantId, normalizedName])
  @@map("patients")
}

model PatientAccess {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  patientId          String          @map("patient_id") @db.Uuid
  patient            Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  customerAccountId  String          @map("customer_account_id") @db.Uuid
  customer           CustomerAccount @relation(fields: [tenantId, customerAccountId], references: [tenantId, id])
  scopes             String[]
  authorizationType  String          @map("authorization_type")
  evidenceDocumentId String?         @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document?       @relation(fields: [tenantId, evidenceDocumentId], references: [tenantId, id])
  verifiedByStaffId  String          @map("verified_by_staff_id") @db.Uuid
  verifiedBy         StaffAccount    @relation(fields: [tenantId, verifiedByStaffId], references: [tenantId, id])
  verifiedAt         DateTime        @map("verified_at")
  expiresAt          DateTime?       @map("expires_at")
  revokedAt          DateTime?       @map("revoked_at")
  status             String          @default("ACTIVE")

  @@index([tenantId, customerAccountId, patientId])
  @@map("patient_access")
}

model PatientDuplicateReview {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  candidatePatientId String       @map("candidate_patient_id") @db.Uuid
  candidate          Patient      @relation(fields: [tenantId, candidatePatientId], references: [tenantId, id])
  subjectId          String       @map("subject_id") @db.Uuid
  reviewedBy         String       @map("reviewed_by") @db.Uuid
  reviewer           StaffAccount @relation(fields: [tenantId, reviewedBy], references: [tenantId, id])
  decision           String
  reason             String
  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([tenantId, subjectId])
  @@map("patient_duplicate_reviews")
}

model RequestStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  request    ServiceRequest @relation(fields: [tenantId, requestId], references: [tenantId, id])
  fromStatus String?        @map("from_status")
  toStatus   String         @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  at         DateTime       @default(now())

  @@index([tenantId, requestId])
  @@map("request_status_history")
}

model GuestActionToken {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  requestId       String         @map("request_id") @db.Uuid
  request         ServiceRequest @relation(fields: [tenantId, requestId], references: [tenantId, id])
  tokenHash       String         @unique @map("token_hash")
  encryptedSecret String?        @map("encrypted_secret")
  purpose         String         @default("REQUEST_STATUS")
  emailHash       String         @map("email_hash")
  expiresAt       DateTime       @map("expires_at")
  consumedAt      DateTime?      @map("consumed_at")

  @@index([tenantId, requestId])
  @@map("guest_action_tokens")
}

model GuestSession {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  request    ServiceRequest @relation(fields: [tenantId, requestId], references: [tenantId, id])
  secretHash String         @unique @map("secret_hash")
  expiresAt  DateTime       @map("expires_at")

  @@index([tenantId, requestId])
  @@map("guest_sessions")
}

model RequestNotification {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  requestId String         @map("request_id") @db.Uuid
  request   ServiceRequest @relation(fields: [tenantId, requestId], references: [tenantId, id])
  staffId   String         @map("staff_id") @db.Uuid
  staff     StaffAccount   @relation(fields: [tenantId, staffId], references: [tenantId, id])
  eventType String         @default("REQUEST_NEW") @map("event_type")
  readAt    DateTime?      @map("read_at")
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([tenantId, requestId, staffId, eventType])
  @@map("request_notifications")
}

model EmailDelivery {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @unique @map("event_id") @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  event         OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id])
  status        String      @default("PENDING")
  attempts      Int         @default(0)
  retryAt       DateTime    @default(now()) @map("retry_at")
  leaseUntil    DateTime?   @map("lease_until")
  lastErrorCode String?     @map("last_error_code")

  @@index([status, retryAt])
  @@map("email_deliveries")
}

model NotificationPolicy {
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  eventType String @map("event_type")
  channel String
  enabled Boolean
  reminderOffsetMin Int? @map("reminder_offset_min")
  updatedBy String @map("updated_by") @db.Uuid
  updater StaffAccount @relation(fields: [tenantId, updatedBy], references: [tenantId, id])
  updatedAt DateTime @updatedAt @map("updated_at")
  @@id([tenantId, eventType, channel])
  @@map("notification_policies")
}

/// Polymorphic principal checked against the same tenant by workflow services.
model NotificationPreference {
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  principalType PrincipalType @map("principal_type")
  principalId String @map("principal_id") @db.Uuid
  eventType String @map("event_type")
  channel String
  optedOut Boolean @default(false) @map("opted_out")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@id([tenantId, principalType, principalId, eventType, channel])
  @@map("notification_preferences")
}

/// Codes and IDs only; localized safe previews are rendered at the UI seam.
model Notification {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id])
  principalType PrincipalType @map("principal_type")
  recipientPrincipalId String @map("recipient_principal_id") @db.Uuid
  eventType String @map("event_type")
  entityType String @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, eventId, principalType, recipientPrincipalId])
  @@index([tenantId, recipientPrincipalId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id])
  principalType String @map("principal_type")
  recipientPrincipalId String @map("recipient_principal_id") @db.Uuid
  eventType String @map("event_type")
  channel String @default("EMAIL")
  status String @default("PENDING")
  attempts Int @default(0)
  retryAt DateTime @default(now()) @map("retry_at")
  leaseUntil DateTime? @map("lease_until")
  executionToken String? @map("execution_token") @db.Uuid
  lastErrorCode String? @map("last_error_code")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, eventId, principalType, recipientPrincipalId, channel])
  @@index([tenantId, status, retryAt])
  @@map("notification_deliveries")
}

/// docs 04 BR-QTE / docs 06 — versioned commercial offers. All versions of a
/// request's offer share quoteGroupId; content freezes at SENT (only state
/// timestamps change afterwards). One effective SENT and at most one DRAFT per
/// group are enforced by partial unique indexes in the Sprint 3 migration.
model Quote {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  requestId       String                 @map("request_id") @db.Uuid
  request         ServiceRequest         @relation(fields: [tenantId, requestId], references: [tenantId, id])
  quoteGroupId    String                 @map("quote_group_id") @db.Uuid
  version         Int
  rowVersion      Int                    @default(1) @map("row_version")
  status          String                 @default("DRAFT")
  currency        String                 @db.Char(3)
  lineItems       Json                   @map("line_items_snapshot")
  totalMinor      Int                    @map("total_minor")
  terms           String
  validUntil      DateTime?              @map("valid_until")
  sentAt          DateTime?              @map("sent_at")
  acceptedAt      DateTime?              @map("accepted_at")
  rejectedAt      DateTime?              @map("rejected_at")
  acceptedByType  String?                @map("accepted_by_type")
  acceptedById    String?                @map("accepted_by_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  revisionTargets QuoteRevisionRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, quoteGroupId, version])
  @@index([tenantId, requestId, version])
  @@index([tenantId, quoteGroupId, status])
  @@map("quotes")
}

/// docs 04 BR-QTE — customer revision requests; one PENDING per quoteGroup is
/// enforced by a partial unique index. While PENDING, acceptance is disabled.
model QuoteRevisionRequest {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  quoteGroupId    String    @map("quote_group_id") @db.Uuid
  quoteId         String    @map("quote_id") @db.Uuid
  quote           Quote     @relation(fields: [tenantId, quoteId], references: [tenantId, id])
  message         String
  status          String    @default("PENDING")
  requestedByType String    @map("requested_by_type")
  requestedById   String?   @map("requested_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  declineReason   String?   @map("decline_reason")

  @@unique([tenantId, id])
  @@index([tenantId, quoteGroupId])
  @@index([tenantId, quoteId])
  @@map("quote_revision_requests")
}

/// docs 06 — replay-safe high-impact customer actions (quote accept).
/// principalId is `customer:<accountId>` or `guest:<sessionId>`; only a safe
/// response summary is stored, never the full payload.
model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  principalId     String   @map("principal_id")
  key             String
  requestHash     String   @map("request_hash")
  responseSummary Json     @map("response_summary")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  @@unique([tenantId, principalId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

/// docs 04 BR-PLAN / docs 06 — care plan header. Versions carry the immutable
/// content; primary caregiver is a preference, never an assignment bypass.
model CarePlan {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  patientId          String          @map("patient_id") @db.Uuid
  patient            Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  serviceRequestId   String?         @map("service_request_id") @db.Uuid
  request            ServiceRequest? @relation(fields: [tenantId, serviceRequestId], references: [tenantId, id])
  agencyServiceId    String          @map("agency_service_id") @db.Uuid
  service            AgencyService   @relation(fields: [tenantId, agencyServiceId], references: [tenantId, id])
  primaryCaregiverId String?         @map("primary_caregiver_id") @db.Uuid
  primaryCaregiver   Caregiver?      @relation("PlanPrimaryCaregiver", fields: [tenantId, primaryCaregiverId], references: [tenantId, id])
  status             String          @default("DRAFT")
  currentVersion     Int             @default(0) @map("current_version")
  startedAt          DateTime?       @map("started_at")
  closedAt           DateTime?       @map("closed_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  versions CarePlanVersion[]
  visits   Visit[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("care_plans")
}

/// docs 06 — one row per plan version. DRAFT is editable; APPROVED/ACTIVATED
/// content is immutable history (approvedBy binds the exact version).
model CarePlanVersion {
  id                             String        @id @default(uuid()) @db.Uuid
  tenantId                       String        @map("tenant_id") @db.Uuid
  carePlanId                     String        @map("care_plan_id") @db.Uuid
  carePlan                       CarePlan      @relation(fields: [tenantId, carePlanId], references: [tenantId, id])
  version                        Int
  status                         String        @default("DRAFT")
  validFrom                      String        @map("valid_from") @db.VarChar(10)
  validUntil                     String        @map("valid_until") @db.VarChar(10)
  weekdaysJson                   Json          @map("weekdays_json")
  localStartTime                 String        @map("local_start_time") @db.VarChar(5)
  durationMin                    Int           @map("duration_min")
  goalText                       String?       @map("goal_text")
  taskTemplatesJson              Json          @map("task_templates_json")
  clinicalInstructionsRestricted String?       @map("clinical_instructions_restricted")
  timezoneSnapshot               String        @map("timezone_snapshot")
  dstResolution                  String        @default("REJECT") @map("dst_resolution")
  approvedByStaffId              String?       @map("approved_by_staff_id") @db.Uuid
  approvedBy                     StaffAccount? @relation("PlanClinicalApprover", fields: [tenantId, approvedByStaffId], references: [tenantId, id])
  approvedAt                     DateTime?     @map("approved_at")
  activatedAt                    DateTime?     @map("activated_at")
  createdAt                      DateTime      @default(now()) @map("created_at")

  visits Visit[]

  @@unique([tenantId, id])
  @@unique([tenantId, carePlanId, version])
  @@map("care_plan_versions")
}

/// docs 04 BR-VST / docs 06 — generated or future standalone visit proposals.
/// Generated visits are PLANNED/unassigned; only transactional assignment
/// confirms. occurrenceKey uniqueness (partial index in the migration) makes
/// generation replay-safe.
model Visit {
  reminderRevision Int @default(0) @map("reminder_revision")
  reminders VisitReminder[]
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  patientId           String           @map("patient_id") @db.Uuid
  patient             Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id])
  agencyServiceId     String           @map("agency_service_id") @db.Uuid
  service             AgencyService    @relation(fields: [tenantId, agencyServiceId], references: [tenantId, id])
  carePlanId          String?          @map("care_plan_id") @db.Uuid
  carePlan            CarePlan?        @relation(fields: [tenantId, carePlanId], references: [tenantId, id])
  planVersionId       String?          @map("plan_version_id") @db.Uuid
  planVersion         CarePlanVersion? @relation(fields: [tenantId, planVersionId], references: [tenantId, id])
  occurrenceKey       String?          @map("occurrence_key") @db.VarChar(96)
  assignedCaregiverId String?          @map("assigned_caregiver_id") @db.Uuid
  assignedCaregiver   Caregiver?       @relation("VisitAssignment", fields: [tenantId, assignedCaregiverId], references: [tenantId, id])
  areaId              String           @map("area_id")
  serviceNameSnapshot Json             @map("service_name_snapshot")
  scheduledStartUtc   DateTime         @map("scheduled_start_utc")
  scheduledEndUtc     DateTime         @map("scheduled_end_utc")
  timezoneSnapshot    String           @map("timezone_snapshot")
  status              String           @default("PLANNED")
  assignmentHealth    String           @default("OK") @map("assignment_health")
  reviewStatus        String           @default("NOT_REQUIRED") @map("review_status")
  actualStartAt       DateTime?        @map("actual_start_at")
  actualEndAt         DateTime?        @map("actual_end_at")
  completionSnapshotJson Json?         @map("completion_snapshot_json")
  cancelledReason     String?          @map("cancelled_reason")
  cancelledAt         DateTime?        @map("cancelled_at")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tasks             VisitTask[]
  assignmentHistory VisitAssignmentHistory[]
  notes             VisitNote[]
  changeRequests    VisitChangeRequest[]
  reviews           VisitReview[]

  @@unique([tenantId, id])
  @@index([tenantId, assignedCaregiverId, scheduledStartUtc, status])
  @@index([tenantId, patientId, scheduledStartUtc])
  @@index([tenantId, carePlanId])
  @@index([tenantId, status, scheduledStartUtc])
  @@map("visits")
}

/// Immutable generation snapshots; the outbox uses the same ID, no payload content.
model VisitReminder {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  visit Visit @relation(fields: [tenantId, visitId], references: [tenantId, id])
  revision Int
  channel String
  offsetMin Int @map("offset_min")
  dueAt DateTime @map("due_at")
  scheduledStartUtc DateTime @map("scheduled_start_utc")
  @@unique([tenantId, visitId, revision, channel, offsetMin], map: "visit_reminders_generation_key")
  @@index([tenantId, dueAt])
  @@map("visit_reminders")
}

/// docs 06 — per-visit task snapshot derived from the effective plan version;
/// outcomes stay PENDING until the Sprint 6 execution flows.
model VisitTask {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  visitId             String    @map("visit_id") @db.Uuid
  visit               Visit     @relation(fields: [tenantId, visitId], references: [tenantId, id])
  order               Int
  descriptionSnapshot String    @map("description_snapshot")
  isRequired          Boolean   @default(true) @map("is_required")
  outcome             String    @default("PENDING")
  notDoneReason       String?   @map("not_done_reason")
  doneAt              DateTime? @map("done_at")
  updatedBy           String?   @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([tenantId, visitId])
  @@map("visit_tasks")
}

/// docs 06 — append-only assignment/reassignment history.
model VisitAssignmentHistory {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  visitId        String   @map("visit_id") @db.Uuid
  visit          Visit    @relation(fields: [tenantId, visitId], references: [tenantId, id])
  oldCaregiverId String?  @map("old_caregiver_id") @db.Uuid
  newCaregiverId String   @map("new_caregiver_id") @db.Uuid
  changedBy      String   @map("changed_by") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([tenantId, visitId])
  @@map("visit_assignment_history")
}

/// docs 04 BR-VST / docs 06 — visit notes. One editable draft per
/// (visit, author) until completion finalizes the snapshot; finalized rows
/// are immutable. Corrections are append-only addenda referencing the
/// original note (original content never rewritten).
model VisitNote {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tenant          Tenant     @relation(fields: [tenantId], references: [id], map: "visit_notes_tenant_id_fkey")
  visitId         String     @map("visit_id") @db.Uuid
  visit           Visit      @relation(fields: [tenantId, visitId], references: [tenantId, id], map: "visit_notes_visit_id_fkey")
  authorId        String     @map("author_id") @db.Uuid
  author          StaffAccount @relation(fields: [tenantId, authorId], references: [tenantId, id], map: "visit_notes_author_fkey")
  bodyRestricted  String     @map("body_restricted")
  isDraft         Boolean    @default(true) @map("is_draft")
  isAddendum      Boolean    @default(false) @map("is_addendum")
  parentNoteId    String?    @map("parent_note_id") @db.Uuid
  parentNote      VisitNote? @relation("NoteCorrection", fields: [tenantId, parentNoteId], references: [tenantId, id], onDelete: Restrict, map: "visit_notes_parent_note_id_fkey")
  addenda         VisitNote[] @relation("NoteCorrection")
  reason          String?
  finalizedAt     DateTime?  @map("finalized_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId, visitId])
  @@map("visit_notes")
}

/// docs 04 BR-CHG / docs 06 — customer single-occurrence visit change
/// requests. Original schedule is untouched while PENDING; the partial
/// unique index (migration) enforces one PENDING request per visit.
model VisitChangeRequest {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  tenant             Tenant          @relation(fields: [tenantId], references: [id], map: "visit_change_requests_tenant_id_fkey")
  visitId            String          @map("visit_id") @db.Uuid
  visit              Visit           @relation(fields: [tenantId, visitId], references: [tenantId, id], map: "visit_change_requests_visit_id_fkey")
  requesterAccountId String          @map("requester_account_id") @db.Uuid
  requester          CustomerAccount @relation(fields: [tenantId, requesterAccountId], references: [tenantId, id], map: "visit_change_requests_requester_fkey")
  type               String
  status             String          @default("PENDING")
  urgency            String          @default("NORMAL")
  proposedStartUtc   DateTime?       @map("proposed_start_utc")
  reason             String
  policySnapshotJson Json            @map("policy_snapshot_json")
  decisionByStaffId  String?         @map("decision_by_staff_id") @db.Uuid
  decisionBy        StaffAccount?   @relation(fields: [tenantId, decisionByStaffId], references: [tenantId, id], onDelete: Restrict, map: "visit_change_requests_decision_by_fkey")
  decisionAt         DateTime?       @map("decision_at")
  decisionReason     String?         @map("decision_reason")
  withdrawnAt        DateTime?       @map("withdrawn_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId, status, urgency])
  @@index([tenantId, visitId])
  @@map("visit_change_requests")
}

/// Review is independent from execution and correction documentation.
model VisitReview {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  visit Visit @relation(fields: [tenantId, visitId], references: [tenantId, id])
  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer StaffAccount @relation(fields: [tenantId, reviewerId], references: [tenantId, id])
  noteRestricted String? @map("note_restricted")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, visitId])
  @@map("visit_reviews")
}
