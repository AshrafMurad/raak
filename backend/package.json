{
  "name": "raak-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Raak backend — Express API, BullMQ worker, Prisma/PostgreSQL (Sprint 0)",
  "type": "module",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "node scripts/build.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "prisma db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bullmq": "~6.4.2",
    "dotenv": "~18.0.9",
    "express": "~5.3.0",
    "ioredis": "~6.0.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/express": "~5.0.6",
    "@types/node": "~24.19.2",
    "@types/supertest": "~7.2.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "esbuild": "~0.28.2",
    "globals": "~17.13.0",
    "prettier": "~3.9.10",
    "prisma": "~7.10.1",
    "supertest": "~7.3.1",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~4.1.12"
  }
}
