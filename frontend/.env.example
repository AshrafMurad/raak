# Raak frontend — environment sample (Sprint 1)
# Copy to `.env.local` for Next.js. NEVER commit real secrets.

# Development API origin (no trailing slash). The client preserves this port
# while selecting platform.localhost or the current tenant hostname. In
# production, leave empty for same-origin /v1 routing at the trusted edge.
NEXT_PUBLIC_API_BASE_URL="http://platform.localhost:3001"

# Server-only web readiness probe; never selected from browser request input.
API_INTERNAL_BASE_URL="http://localhost:3001"

# Base domain for tenant portal hostnames (dev placeholder; no DNS name assumed reserved)
NEXT_PUBLIC_BASE_DOMAIN="localhost"
