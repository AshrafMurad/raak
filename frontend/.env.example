# Raak frontend — environment sample (Sprint 0)
# Copy to `.env.local` for Next.js. NEVER commit real secrets.

# Backend REST API base (no trailing slash)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# Server-only web readiness probe; never selected from browser request input.
API_INTERNAL_BASE_URL="http://localhost:3001"

# Base domain for tenant portal hostnames (dev placeholder; no DNS name assumed reserved)
NEXT_PUBLIC_BASE_DOMAIN="raak.local"
