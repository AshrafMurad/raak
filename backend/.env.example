# Raak backend — environment sample (Sprint 1)
# Copy to `.env` and adjust. NEVER commit real secrets.
# Values below are local docker-compose development defaults; all data is synthetic.

# --- Database (postgres service) ---
DATABASE_URL="postgresql://raak:raak-dev-only@localhost:5432/raak"
# Optional compose port override if a native PostgreSQL already uses 5432.
RAAK_PG_HOST_PORT="5432"
SHADOW_DATABASE_URL="postgresql://raak:raak-dev-only@localhost:5432/raak_shadow"

# --- Queue/cache (redis service) ---
REDIS_URL="redis://localhost:6379"
# Keep REDIS_URL's port in sync with this compose host port.
RAAK_REDIS_HOST_PORT="6379"

# --- Private S3-compatible object storage (Sprint 4) ---
# Leave unset until a PRIVATE bucket exists. No storage/scanner image is pulled
# automatically. Missing configuration returns 503; never a public file URL.
# Production requires HTTPS; credentials need create-only PutObject/GetObject
# plus DeleteObject on the _raak_private_probe/ prefix only. Startup verifies
# anonymous GET denial with a non-sensitive probe before enabling uploads.
# OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
# OBJECT_STORAGE_ACCESS_KEY="local-dev-key"
# OBJECT_STORAGE_SECRET_KEY="local-dev-secret"
# OBJECT_STORAGE_BUCKET="raak-private"
# Real ClamAV INSTREAM engine; missing/unreachable engine quarantines files.
# CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"

# --- Sessions / crypto (generate a strong random value for anything beyond local dev) ---
SESSION_SECRET="dev-only-change-me-32-bytes-minimum!"

# --- Sprint 2 request receipt / verification email (Resend HTTP adapter) ---
# Set both to enable delivery; a verified sender/domain is required.
# API and worker must share SESSION_SECRET to decrypt short-lived delivery tokens.
# Without these, events remain pending and the worker logs EMAIL_NOT_CONFIGURED.
EMAIL_API_KEY=""
EMAIL_FROM=""
PORTAL_PORT="3000"

# --- Trusted host realms (use *.localhost in dev; browser resolves it locally) ---
BASE_DOMAIN="localhost"
PLATFORM_HOST="platform.localhost"

# Comma-separated development origins allowed to send credentialed API
# requests. Production uses same-origin /v1 ingress (ADR-0008).
API_CORS_ORIGINS="http://platform.localhost:3000,http://afiya.localhost:3000"

# --- Reverse proxy trust (docs 08: never trust arbitrary Host/X-Forwarded-*) ---
TRUSTED_PROXY_HOSTS="localhost,127.0.0.1"

# --- App ports (local dev) ---
API_PORT="3001"
WORKER_HEALTH_PORT="8081"

# --- Logging: debug | info | warn | error ---
LOG_LEVEL="info"
