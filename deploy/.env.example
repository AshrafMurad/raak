# Raak production deployment placeholders (Session 6, docs/15).
# Copy to a protected location or enter via Coolify managed secrets.
# NEVER commit real values. Validation only: docker compose
# --env-file deploy/.env.example -f deploy/docker-compose.prod.yml config

# --- PostgreSQL (compose-internal service) ---
# The password is embedded into DATABASE_URL, so keep it URL-safe
# (letters, digits and underscores only) or pre-encode it.
POSTGRES_USER=raak
POSTGRES_PASSWORD=replace-with-strong-url-safe-password
POSTGRES_DB=raak

# --- Security ---
# At least 32 bytes; API and worker must share it.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# --- Public hosts (Coolify/Traefik edge per ADR-0008) ---
BASE_DOMAIN=raak.example.com
PLATFORM_HOST=platform.raak.example.com

# --- Reverse proxy trust ---
# proxy-addr tokens for the edge IPs/subnets the API should trust for
# forwarded headers. Empty means trust no proxy (direct connections only).
TRUSTED_PROXY_HOSTS=

# --- Logging ---
LOG_LEVEL=info

# --- Email (owner gate; leave empty to keep delivery pending/EMAIL_NOT_CONFIGURED) ---
EMAIL_API_KEY=
EMAIL_FROM=

# --- Private S3-compatible object storage (owner gate; uploads stay 503 while unset) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1

# --- Antivirus (owner gate; files quarantine while unset) ---
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Owner-built images (downloads are owner-run; see docs/15) ---
BACKEND_IMAGE=raak-backend:local
FRONTEND_IMAGE=raak-frontend:local
