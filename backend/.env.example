# Raak backend — environment sample (Sprint 1)
# Copy to `.env` and adjust. NEVER commit real secrets.
# Values below are local docker-compose development defaults; all data is synthetic.

# --- Database (postgres service) ---
DATABASE_URL="postgresql://raak:raak-dev-only@localhost:5432/raak"
# Optional compose port override if a native PostgreSQL already uses 5432.
RAAK_PG_HOST_PORT="5432"
SHADOW_DATABASE_URL="postgresql://raak:raak-dev-only@localhost:5432/raak_shadow"

# --- Queue/cache (redis service) ---
REDIS_URL="redis://localhost:6379"
# Keep REDIS_URL's port in sync with this compose host port.
RAAK_REDIS_HOST_PORT="6379"

# --- Object storage (localstack S3-compatible dev service; consumed from Sprint 4) ---
OBJECT_STORAGE_ENDPOINT="http://localhost:4566"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY="raak"
OBJECT_STORAGE_SECRET_KEY="raak-dev-only-secret"
BUCKET="raak-private"

# --- Sessions / crypto (generate a strong random value for anything beyond local dev) ---
SESSION_SECRET="dev-only-change-me-32-bytes-minimum!"

# --- Email provider (worker stub does not send real mail in Sprint 0) ---
EMAIL_PROVIDER="smtp"
EMAIL_FROM_ADDRESS="no-reply@example.invalid"
EMAIL_FROM_NAME="Raak (dev)"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Trusted host realms (use *.localhost in dev; browser resolves it locally) ---
BASE_DOMAIN="localhost"
PLATFORM_HOST="platform.localhost"

# Comma-separated development origins allowed to send credentialed API
# requests. Production uses same-origin /v1 ingress (ADR-0008).
API_CORS_ORIGINS="http://platform.localhost:3000,http://afiya.localhost:3000"

# --- Reverse proxy trust (docs 08: never trust arbitrary Host/X-Forwarded-*) ---
TRUSTED_PROXY_HOSTS="localhost,127.0.0.1"

# --- App ports (local dev) ---
API_PORT="3001"
WORKER_HEALTH_PORT="8081"

# --- Logging: debug | info | warn | error ---
LOG_LEVEL="info"
